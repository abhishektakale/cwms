# Local development defaults — copy to repo root `.env` or `backend/.env`
# Never commit real secrets.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://cwms:cwms_dev_password@localhost:5433/cwms?schema=public

SESSION_IDLE_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=14
CORS_ORIGIN=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cwmsminio
S3_SECRET_KEY=cwmsminio_dev_password
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=true

# Profit/Loss policy (Doc 13 A-EXP-01 default)
PROFIT_LOSS_MODE=gross_minus_expenditure
