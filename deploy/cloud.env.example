# =============================================================================
# CWMS cloud / UAT environment (split stack)
# Copy values into Neon, R2, Render|Railway, and Pages|Vercel dashboards.
# Never commit real secrets.
# =============================================================================

# --- Neon (PostgreSQL) -------------------------------------------------------
# Use the pooled connection string for the API (Prisma).
# Example: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/cwms?sslmode=require
DATABASE_URL=

# --- Cloudflare R2 -----------------------------------------------------------
# Account → R2 → Manage R2 API Tokens → create token with Object Read & Write
# Endpoint form: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=false

# --- Alternative: MinIO instead of R2 -----------------------------------------
# Path A (full Docker on one VM): use compose defaults (http://minio:9000, path-style true).
# Path B (split cloud): public or private MinIO HTTPS URL, for example:
# S3_ENDPOINT=https://minio.your-domain.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=cwmsminio
# S3_SECRET_KEY=choose-a-strong-password
# S3_BUCKET_DOCUMENTS=cwms-documents
# S3_BUCKET_BACKUPS=cwms-backups
# S3_FORCE_PATH_STYLE=true
# Create buckets cwms-documents and cwms-backups in MinIO before first upload.
# Or omit all S3_* for in-memory fake storage (uploads lost on API restart).

# --- API (Render or Railway) -------------------------------------------------
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# Exact SPA origin(s), comma-separated — no trailing slash
CORS_ORIGIN=https://your-app.pages.dev
# Required for cross-origin SPA ↔ API cookie auth
COOKIE_SAMESITE=none
COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=14
PROFIT_LOSS_MODE=gross_minus_expenditure
# Seed demo users on boot (set false after first successful deploy if preferred)
CWMS_SEED=true

# --- SPA (Cloudflare Pages or Vercel) — build-time only ----------------------
# Full public API URL including /api/v1 (no trailing slash after v1)
VITE_API_BASE_URL=https://cwms-api.onrender.com/api/v1
