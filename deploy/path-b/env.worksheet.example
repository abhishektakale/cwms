# Path B worksheet — fill as you deploy (do not commit secrets)

## URLs

API_PUBLIC_URL=
SPA_PUBLIC_URL=

## Neon

DATABASE_URL=

## Files

# Skipped for initial UAT — omit all S3_* on the API
DOCUMENTS_UPLOAD_ENABLED=false

## API (Render / Railway) — paste into dashboard

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=
CORS_ORIGIN=
COOKIE_SAMESITE=none
COOKIE_SECURE=true
DOCUMENTS_UPLOAD_ENABLED=false
CWMS_SEED=true
SESSION_IDLE_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=14
PROFIT_LOSS_MODE=gross_minus_expenditure

## SPA (Pages / Vercel) — build env

VITE_API_BASE_URL=
# must be: https://YOUR_API_HOST/api/v1
