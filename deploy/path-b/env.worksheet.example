# Path B worksheet — fill as you deploy (do not commit secrets)

## URLs

API_PUBLIC_URL=
SPA_PUBLIC_URL=
MINIO_S3_URL=

## Neon

DATABASE_URL=

## MinIO

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=true

## API (Render / Railway) — paste into dashboard

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=
CORS_ORIGIN=
COOKIE_SAMESITE=none
COOKIE_SECURE=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=true
CWMS_SEED=true
SESSION_IDLE_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=14
PROFIT_LOSS_MODE=gross_minus_expenditure

## SPA (Pages / Vercel) — build env

VITE_API_BASE_URL=
# must be: https://YOUR_API_HOST/api/v1
