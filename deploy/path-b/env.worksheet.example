# Path B worksheet — fill as you deploy (do not commit secrets)

## URLs

API_PUBLIC_URL=
SPA_PUBLIC_URL=

## Neon

DATABASE_URL=

## Cloudflare R2

# Endpoint: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=false
# Leave unset (or true). Set false only to force-disable uploads.
# DOCUMENTS_UPLOAD_ENABLED=true

## API (Render / Railway) — paste into dashboard

NODE_ENV=production
API_PREFIX=api/v1
DATABASE_URL=
CORS_ORIGIN=
COOKIE_SAMESITE=none
COOKIE_SECURE=true
CWMS_SEED=true
SESSION_IDLE_TIMEOUT_MINUTES=30
REMEMBER_ME_DAYS=14
PROFIT_LOSS_MODE=gross_minus_expenditure
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=cwms-documents
S3_BUCKET_BACKUPS=cwms-backups
S3_FORCE_PATH_STYLE=false

## SPA (Vercel recommended) — build env

VITE_API_BASE_URL=/api/v1
# Pages alternative: https://YOUR_API_HOST/api/v1
