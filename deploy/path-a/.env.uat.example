# Copy to .env.uat and fill in. Never commit .env.uat.
#
#   cp deploy/path-a/.env.uat.example deploy/path-a/.env.uat

# Public HTTPS origin testers will use (no trailing slash)
CORS_ORIGIN=https://cwms-uat.example.com
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

POSTGRES_USER=cwms
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cwms

MINIO_ROOT_USER=cwmsminio
MINIO_ROOT_PASSWORD=change-me-strong-minio-password

CWMS_SEED=true
