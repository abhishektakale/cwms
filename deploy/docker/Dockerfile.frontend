# CWMS SPA image (Vite build + nginx)
# Build from repository root:
#   docker build -f deploy/docker/Dockerfile.frontend -t cwms-frontend \
#     --build-arg VITE_API_BASE_URL=/api/v1 .

FROM node:20-bookworm-slim AS build
WORKDIR /app

ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY ui/design-system/package.json ./ui/design-system/

RUN npm ci --ignore-scripts

COPY frontend ./frontend
COPY ui/design-system ./ui/design-system
COPY ui/color-palette ./ui/color-palette

RUN npm run build -w frontend

FROM nginx:1.27-alpine AS runtime
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's/\r$//' /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
