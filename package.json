{
  "name": "cwms",
  "version": "0.1.0",
  "private": true,
  "description": "Construction Work Management System (CWMS) v1.0",
  "workspaces": [
    "frontend",
    "backend",
    "ui/design-system"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run start:dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend",
    "docker:up": "docker compose -f deploy/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f deploy/docker/docker-compose.yml down",
    "docker:ps": "docker compose -f deploy/docker/docker-compose.yml ps",
    "docker:logs": "docker compose -f deploy/docker/docker-compose.yml logs -f --tail=100"
  },
  "engines": {
    "node": ">=20"
  }
}
